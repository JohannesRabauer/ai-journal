# Copy to .env (never commit .env). Used by docker-compose and scripts/run-*.
# Full reference of every setting: docs/CONFIG.md

# Database password for the "ai-diary" user. For a NEW database it is set on first start.
# Existing pre-v1 databases were created with "trust" auth: see docs/PRIVACY.md, "Securing an existing database".
JOURNAL_DB_PASSWORD=change-me-to-a-long-random-value

# ---- Profile A (docker compose), all optional -----------------------------------------------------------------
# Linux only: user id/group id the backend and piper containers run as (must own ./data/audio and ./data/piper).
# JOURNAL_UID=1000
# JOURNAL_GID=1000
# Speech output is off by default (none). With the "tts" compose profile (Piper) switch it on:
# JOURNAL_TTS_PROVIDER=piper
# Models pulled once by the ollama container (space separated) and the Whisper model (Hugging Face id).
# OLLAMA_MODELS_TO_PULL=qwen3-embedding:0.6b qwen3:1.7b
# WHISPER_MODEL=Systran/faster-whisper-small
# Keep the Postgres data directory somewhere else than ./db/data (e.g. outside the repository).
# JOURNAL_DB_DATA_DIR=./db/data
# JOURNAL_AUDIO_DATA_DIR=./data/audio

# ---- Profile B (plain Java, scripts/run-*.ps1|sh): endpoints of the services you run yourself ------------------
# JOURNAL_DB_URL=jdbc:postgresql://localhost:15432/ai-diary
# JOURNAL_STT_WHISPER_BASE_URL=http://localhost:8000
# JOURNAL_LLM_OLLAMA_BASE_URL=http://localhost:11434
# JOURNAL_EMBEDDING_OLLAMA_BASE_URL=http://localhost:11434
# JOURNAL_TTS_PIPER_BASE_URL=http://localhost:5000
# JOURNAL_AUDIO_FILESYSTEM_DIRECTORY=./data/audio
# BACKEND_URL=http://127.0.0.1:8080

# ---- Profile C (lite-cloud, Raspberry Pi): data LEAVES this device (OpenAI). Leave empty otherwise. ------------
# OPENAI_API_KEY=
# JOURNAL_CLOUD_CONSENT=I_UNDERSTAND_DATA_LEAVES_THIS_DEVICE
