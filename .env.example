# Copy to .env (never commit .env). Used by docker-compose and scripts/run-*.
# Database password for the "ai-diary" user. For a NEW database it is set on first start.
# Existing pre-v1 databases were created with "trust" auth: see docs/PRIVACY.md, "Securing an existing database".
JOURNAL_DB_PASSWORD=change-me-to-a-long-random-value

# Only for the lite-cloud profile (Raspberry Pi). Leave empty otherwise.
# OPENAI_API_KEY=
# JOURNAL_CLOUD_CONSENT=I_UNDERSTAND_DATA_LEAVES_THIS_DEVICE
