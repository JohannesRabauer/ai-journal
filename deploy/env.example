# Copy to /etc/ai-diary/env on the Pi:  sudo install -m 0600 -o root -g root env.example /etc/ai-diary/env
# The file is read by systemd (as root) before dropping privileges.
# Data LEAVES this device in the lite-cloud profile (docs/PRIVACY.md).
OPENAI_API_KEY=sk-...
JOURNAL_CLOUD_CONSENT=I_UNDERSTAND_DATA_LEAVES_THIS_DEVICE
