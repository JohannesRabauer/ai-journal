# AI Diary frontend (Vaadin). Install per docs/PI.md. Binds to 127.0.0.1 by default (use an SSH tunnel);
# opening it to the home network is a deliberate choice, see JOURNAL_HTTP_HOST below.
[Unit]
Description=AI Diary frontend
After=ai-diary-backend.service
Wants=ai-diary-backend.service

[Service]
User=ai-diary
Group=ai-diary
# Optional settings only (JOURNAL_HTTP_HOST, JOURNAL_ALLOWED_HOSTS); it must NOT hold OPENAI_API_KEY, which only the
# backend needs. The leading "-" makes the file optional. See deploy/frontend.env.example.
EnvironmentFile=-/etc/ai-diary/frontend.env
Environment=BACKEND_URL=http://127.0.0.1:8080
# Localhost only by default (no authentication in v1). LAN opt-in: set JOURNAL_HTTP_HOST=0.0.0.0 and
# JOURNAL_ALLOWED_HOSTS=<name or IP> in /etc/ai-diary/frontend.env (values from the file override this default).
# Never expose the port to the internet; see docs/PI.md.
Environment=JOURNAL_HTTP_HOST=127.0.0.1
WorkingDirectory=/var/lib/ai-diary
ExecStart=/usr/bin/java -Xmx160m -Xms32m -XX:+UseSerialGC -Xss256k -XX:MaxMetaspaceSize=128m -XX:ReservedCodeCacheSize=32m -XX:TieredStopAtLevel=1 -XX:MaxDirectMemorySize=32m -jar /opt/ai-diary/frontend/app.jar
Restart=on-failure
RestartSec=10
MemoryMax=380M
TimeoutStartSec=300

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictNamespaces=true
ReadWritePaths=/var/lib/ai-diary

[Install]
WantedBy=multi-user.target
