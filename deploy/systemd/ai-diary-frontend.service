# AI Diary frontend (Vaadin). Install per docs/PI.md. Binds to all interfaces so other devices in the home network
# can open it; change JOURNAL_HTTP_HOST to 127.0.0.1 to allow only this device (or put a reverse proxy in front).
[Unit]
Description=AI Diary frontend
After=ai-diary-backend.service
Wants=ai-diary-backend.service

[Service]
User=ai-diary
Group=ai-diary
EnvironmentFile=/etc/ai-diary/env
Environment=BACKEND_URL=http://127.0.0.1:8080
Environment=JOURNAL_HTTP_HOST=0.0.0.0
WorkingDirectory=/var/lib/ai-diary
ExecStart=/usr/bin/java -Xmx160m -Xms32m -XX:+UseSerialGC -Xss256k -XX:MaxMetaspaceSize=128m -XX:ReservedCodeCacheSize=32m -XX:TieredStopAtLevel=1 -XX:MaxDirectMemorySize=32m -jar /opt/ai-diary/frontend/app.jar
Restart=on-failure
RestartSec=10
MemoryMax=380M
TimeoutStartSec=300

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictNamespaces=true
ReadWritePaths=/var/lib/ai-diary

[Install]
WantedBy=multi-user.target
