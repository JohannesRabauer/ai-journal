# Copy to /etc/ai-diary/backend.env on the Pi:
#   sudo install -m 0600 -o root -g root backend.env.example /etc/ai-diary/backend.env
# Read by the ai-diary-backend unit (systemd reads it as root before dropping privileges). That one JVM serves the
# REST API and the web pages (D-033).
# Data LEAVES this device in the lite-cloud profile (docs/PRIVACY.md).
OPENAI_API_KEY=sk-...
JOURNAL_CLOUD_CONSENT=I_UNDERSTAND_DATA_LEAVES_THIS_DEVICE
# LAN opt-in (anyone on that network can then read your journal, never expose
# it to the internet): bind on all interfaces AND list the name or IP you type into the browser, otherwise the Host
# check answers 421. Default: 127.0.0.1 only. See docs/CONFIG.md.
# JOURNAL_HTTP_HOST=0.0.0.0
# JOURNAL_ALLOWED_HOSTS=raspberrypi,raspberrypi.local,192.168.1.50
