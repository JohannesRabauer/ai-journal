# Copy to /etc/ai-diary/backend.env on the Pi:
#   sudo install -m 0600 -o root -g root backend.env.example /etc/ai-diary/backend.env
# Read by the BACKEND unit only (systemd reads it as root before dropping privileges). The frontend unit never
# sees these secrets (it has its own optional /etc/ai-diary/frontend.env, see frontend.env.example).
# Data LEAVES this device in the lite-cloud profile (docs/PRIVACY.md).
OPENAI_API_KEY=sk-...
JOURNAL_CLOUD_CONSENT=I_UNDERSTAND_DATA_LEAVES_THIS_DEVICE
# Extra Host names the backend accepts besides localhost/127.0.0.1/[::1] (only needed with a LAN opt-in, docs/PI.md)
# JOURNAL_ALLOWED_HOSTS=
